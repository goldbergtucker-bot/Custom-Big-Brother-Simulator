/*
 * BIG BROTHER SIMULATOR — EVICTED HOUSEGUEST PORTRAIT CENTERING FIX v2
 *
 * Targets the ACTUAL eviction DOM used by app.js.
 *
 * Root cause:
 * #event-content > div is globally forced to width:100%, which also catches
 * the lone .sim-portrait returned directly by simulationPortrait().
 *
 * This fix restores the portrait itself to its intended 120px width and
 * centers it in the event panel. It does not alter simulation logic,
 * placements, voting, or history.
 */

(function () {
    "use strict";

    function fixEvictionPortrait() {
        const eventContent = document.getElementById("event-content");
        const eventType = document.getElementById("event-type");

        if (!eventContent) return;

        const type = String(eventType?.textContent || "").trim().toUpperCase();
        const title = String(document.getElementById("event-title")?.textContent || "").trim().toLowerCase();

        const isEviction =
            type === "EVICTION" ||
            title === "eviction" ||
            title.includes("eviction");

        if (!isEviction) return;

        /*
         * app.js renders the eviction portrait directly as:
         * #event-content > .sim-portrait.sim-portrait-large
         *
         * style.css later applies:
         * #event-content > div { width:100%; }
         *
         * That broad rule wins over .sim-portrait-large { width:120px; }.
         */
        eventContent.querySelectorAll(":scope > .sim-portrait").forEach(portrait => {
            portrait.style.setProperty("width", "120px", "important");
            portrait.style.setProperty("max-width", "120px", "important");
            portrait.style.setProperty("min-width", "120px", "important");
            portrait.style.setProperty("margin-left", "auto", "important");
            portrait.style.setProperty("margin-right", "auto", "important");
            portrait.style.setProperty("align-self", "center", "important");
            portrait.style.setProperty("justify-self", "center", "important");
            portrait.style.setProperty("text-align", "center", "important");
            portrait.style.setProperty("display", "block", "important");
            portrait.style.setProperty("box-sizing", "border-box", "important");

            const image = portrait.querySelector("img");
            if (image) {
                image.style.setProperty("display", "block", "important");
                image.style.setProperty("width", "120px", "important");
                image.style.setProperty("height", "145px", "important");
                image.style.setProperty("margin-left", "auto", "important");
                image.style.setProperty("margin-right", "auto", "important");
            }

            const placeholder = portrait.querySelector(".sim-portrait-placeholder");
            if (placeholder) {
                placeholder.style.setProperty("margin-left", "auto", "important");
                placeholder.style.setProperty("margin-right", "auto", "important");
            }
        });
    }

    function applyFix() {
        fixEvictionPortrait();
        setTimeout(fixEvictionPortrait, 0);
        setTimeout(fixEvictionPortrait, 50);
        setTimeout(fixEvictionPortrait, 150);
        setTimeout(fixEvictionPortrait, 300);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", applyFix);
    } else {
        applyFix();
    }

    /*
     * showEvent() replaces #event-content.innerHTML, so observe that exact
     * container instead of scanning unrelated headings/cards.
     */
    const eventContent = document.getElementById("event-content");

    if (eventContent) {
        const observer = new MutationObserver(applyFix);
        observer.observe(eventContent, {
            childList: true,
            subtree: true
        });
    }

    const eventType = document.getElementById("event-type");
    const eventTitle = document.getElementById("event-title");

    if (eventType || eventTitle) {
        const observer = new MutationObserver(applyFix);

        if (eventType) {
            observer.observe(eventType, {
                childList: true,
                characterData: true,
                subtree: true
            });
        }

        if (eventTitle) {
            observer.observe(eventTitle, {
                childList: true,
                characterData: true,
                subtree: true
            });
        }
    }

    console.log(
        "EVICTED PORTRAIT CENTERING FIX v2 loaded — targeted to #event-content > .sim-portrait."
    );
})();
